{
	"openapi": "3.0.1",
	"info": {
		"title": "Race Results Repository API",
		"description": "# Race Results Repository API\n\nVersion-controlled repository for rowing regatta timing data based on the Timing Data Interchange EMF schema.\n\n## Features\n- **Version Control**: Full history tracking for all documents with EMF Compare-based diffs\n- **Document Types**: Support for Race Results, Start Lists, and other timing data\n- **Search**: Powerful search with exact, partial, and wildcard matching\n- **Authorization**: Role-based access control for regatta data\n- **Real-time**: Webhook and MQTT support for live updates\n\n## Data Format\nDocuments are stored as EMF (Eclipse Modeling Framework) models in XMI or binary format,\nconforming to the Timing Data Interchange schema for rowing regattas.\n\n## Authentication\nMost endpoints require JWT bearer token authentication. Include the token in the Authorization header:\n```\nAuthorization: Bearer <your-jwt-token>\n```\n",
		"contact": {
			"name": "Race Results Repository Team",
			"url": "https://github.com/rowtown/race-results-repository",
			"email": "support@rowtown.org"
		},
		"license": {
			"name": "Apache 2.0",
			"url": "https://www.apache.org/licenses/LICENSE-2.0"
		},
		"version": "1.0.0"
	},
	"externalDocs": {
		"description": "Timing Data Interchange Schema Documentation",
		"url": "https://github.com/rowtown/timing-data-interchange"
	},
	"servers": [
		{
			"url": "http://localhost:8080",
			"description": "Local development server"
		},
		{
			"url": "https://api.rowtown.org",
			"description": "Production server"
		}
	],
	"security": [
		{
			"bearerAuth": []
		}
	],
	"tags": [
		{
			"name": "Versions",
			"description": "Version control API"
		},
		{
			"name": "Notifications",
			"description": "Notification subscription API"
		},
		{
			"name": "Documents",
			"description": "Document management API"
		},
		{
			"name": "Search",
			"description": "Document search API"
		},
		{
			"name": "Backups",
			"description": "Backup and restore API"
		}
	],
	"paths": {
		"/api/v1/documents/{id}": {
			"get": {
				"tags": [
					"Documents"
				],
				"summary": "Get document by ID",
				"description": "Retrieves the latest version of a document including all metadata and the EMF model data",
				"operationId": "getDocument",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Document ID",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int64"
						},
						"example": 12345
					}
				],
				"responses": {
					"403": {
						"description": "Forbidden - insufficient permissions to access this document",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					},
					"200": {
						"description": "Document retrieved successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					},
					"404": {
						"description": "Document not found",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					}
				}
			},
			"put": {
				"tags": [
					"Documents"
				],
				"summary": "Update document",
				"description": "Updates a document by creating a new version. All previous versions are preserved for full history tracking.",
				"operationId": "updateDocument",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Document ID",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int64"
						},
						"example": 12345
					},
					{
						"name": "changeDescription",
						"in": "query",
						"description": "Description of changes in this version",
						"required": false,
						"schema": {
							"type": "string",
							"default": "Updated document"
						},
						"example": "Updated race times after timing correction"
					},
					{
						"name": "format",
						"in": "query",
						"description": "Serialization format of the model data",
						"required": false,
						"schema": {
							"type": "string",
							"default": "XMI",
							"enum": [
								"XMI",
								"JSON"
							]
						},
						"example": "XMI"
					}
				],
				"requestBody": {
					"description": "Binary EMF model data",
					"content": {
						"application/octet-stream": {},
						"application/json": {
							"schema": {
								"type": "array",
								"items": {
									"type": "string",
									"format": "byte"
								}
							}
						}
					},
					"required": true
				},
				"responses": {
					"403": {
						"description": "Forbidden - insufficient permissions to update this document",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					},
					"200": {
						"description": "Document updated successfully, new version created",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					},
					"400": {
						"description": "Invalid request - malformed model data or invalid format",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					},
					"404": {
						"description": "Document not found",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					}
				}
			},
			"delete": {
				"tags": [
					"Documents"
				],
				"summary": "Delete document",
				"description": "Permanently deletes a document and all its versions. This operation cannot be undone.",
				"operationId": "deleteDocument",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Document ID",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int64"
						},
						"example": 12345
					}
				],
				"responses": {
					"403": {
						"description": "Forbidden - insufficient permissions to delete this document"
					},
					"404": {
						"description": "Document not found"
					},
					"204": {
						"description": "Document deleted successfully"
					}
				}
			}
		},
		"/api/v1/webhooks/subscribe": {
			"post": {
				"tags": [
					"Notifications"
				],
				"summary": "Subscribe to webhook",
				"description": "Register a webhook for document change notifications",
				"operationId": "subscribeWebhook",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/WebhookSubscriptionRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/WebhookSubscriptionInfo"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/documents": {
			"post": {
				"tags": [
					"Documents"
				],
				"summary": "Create a new race timing document",
				"description": "Creates a new document with version 1. The document is stored with full version history and can include race results, start lists, or other timing data in EMF format.",
				"operationId": "createDocument",
				"requestBody": {
					"description": "Document creation request",
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/DocumentRequest"
							},
							"examples": {
								"Race Results": {
									"description": "Race Results",
									"value": {
										"type": "RACE_RESULTS",
										"regattaId": "REG2025-SPRING",
										"timerId": "TIMER-001",
										"milestoneId": "HEAT-1",
										"versionType": "OFFICIAL",
										"author": "john.doe@rowing.org",
										"description": "Final race results for Heat 1",
										"tags": [
											"finals",
											"mens-8"
										],
										"metadata": {
											"weather": "sunny",
											"wind": "5mph"
										}
									}
								}
							}
						}
					},
					"required": true
				},
				"responses": {
					"409": {
						"description": "Conflict - document with same identifier already exists",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					},
					"400": {
						"description": "Invalid request - missing required fields or invalid data format",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					},
					"403": {
						"description": "Forbidden - insufficient permissions for this regatta or document type",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					},
					"201": {
						"description": "Document created successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DocumentResponse"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/documents/{documentId}/versions/rollback": {
			"post": {
				"tags": [
					"Versions"
				],
				"summary": "Rollback document to previous version",
				"description": "Creates a new version that restores the content from a previous version. The rollback itself becomes a new version in the history.",
				"operationId": "rollback",
				"parameters": [
					{
						"name": "documentId",
						"in": "path",
						"description": "Document ID",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int64"
						},
						"example": 12345
					},
					{
						"name": "targetVersion",
						"in": "query",
						"description": "Version number to rollback to",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int64"
						},
						"example": 3
					},
					{
						"name": "description",
						"in": "query",
						"description": "Description for the rollback operation",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "Reverting to pre-correction state"
					}
				],
				"responses": {
					"403": {
						"description": "Forbidden - insufficient permissions to rollback this document",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/VersionInfo"
								}
							}
						}
					},
					"404": {
						"description": "Document or target version not found",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/VersionInfo"
								}
							}
						}
					},
					"200": {
						"description": "Rollback successful, new version created",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/VersionInfo"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/documents/search": {
			"get": {
				"tags": [
					"Search"
				],
				"summary": "Search documents",
				"description": "Search for documents using query parameters. Supports exact, partial, and wildcard matching.",
				"operationId": "search",
				"parameters": [
					{
						"name": "documentId",
						"in": "query",
						"description": "Document ID to search for",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": 12345
					},
					{
						"name": "regattaId",
						"in": "query",
						"description": "Filter by regatta ID",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "REG2025-SPRING"
					},
					{
						"name": "regattaName",
						"in": "query",
						"description": "Search by regatta name",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "Spring Regatta"
					},
					{
						"name": "type",
						"in": "query",
						"description": "Filter by document type",
						"required": false,
						"schema": {
							"type": "string",
							"enum": [
								"START_LIST",
								"RACE_RESULTS"
							]
						},
						"example": "RACE_RESULTS"
					},
					{
						"name": "timerId",
						"in": "query",
						"description": "Filter by timer device ID",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "TIMER-001"
					},
					{
						"name": "author",
						"in": "query",
						"description": "Filter by author",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "john.doe@rowing.org"
					},
					{
						"name": "description",
						"in": "query",
						"description": "Search in document descriptions",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "heat 1"
					},
					{
						"name": "tags",
						"in": "query",
						"description": "Filter by tags (comma-separated)",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "finals,mens-8"
					},
					{
						"name": "metadataKey",
						"in": "query",
						"description": "Search for specific metadata key",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "metadataValue",
						"in": "query",
						"description": "Search for specific metadata value",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "page",
						"in": "query",
						"description": "Page number (0-indexed)",
						"required": false,
						"schema": {
							"type": "integer",
							"format": "int32",
							"default": 0
						},
						"example": 0
					},
					{
						"name": "size",
						"in": "query",
						"description": "Page size",
						"required": false,
						"schema": {
							"type": "integer",
							"format": "int32",
							"default": 10
						},
						"example": 10
					},
					{
						"name": "matchType",
						"in": "query",
						"description": "Match type: EXACT, PARTIAL, or WILDCARD",
						"required": false,
						"schema": {
							"type": "string",
							"description": "Match type for search queries",
							"default": "EXACT",
							"enum": [
								"EXACT",
								"PARTIAL",
								"WILDCARD"
							]
						},
						"example": "PARTIAL"
					}
				],
				"responses": {
					"200": {
						"description": "Search completed successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SearchResults"
								}
							}
						}
					},
					"400": {
						"description": "Invalid search parameters",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/SearchResults"
								}
							}
						}
					}
				}
			},
			"post": {
				"tags": [
					"Search"
				],
				"summary": "Advanced search",
				"description": "Perform complex searches using a JSON query body. Useful for searches with multiple tags, metadata filters, or complex criteria.",
				"operationId": "advancedSearch",
				"requestBody": {
					"description": "Advanced search query",
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SearchQuery"
							},
							"examples": {
								"Search for finals races": {
									"description": "Search for finals races",
									"value": {
										"regattaId": "REG2025-SPRING",
										"documentType": "RACE_RESULTS",
										"tags": [
											"finals",
											"mens-8"
										],
										"matchType": "PARTIAL",
										"page": 0,
										"size": 20
									}
								}
							}
						}
					},
					"required": true
				},
				"responses": {
					"400": {
						"description": "Invalid search query",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/SearchResults"
								}
							}
						}
					},
					"200": {
						"description": "Search completed successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SearchResults"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/backups/{backupId}/restore/selective": {
			"post": {
				"tags": [
					"Backups"
				],
				"summary": "Restore selective documents",
				"description": "Restores specific documents from a backup",
				"operationId": "restoreSelective",
				"parameters": [
					{
						"name": "backupId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"type": "array",
								"items": {
									"type": "integer",
									"format": "int64"
								}
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "OK"
					}
				}
			}
		},
		"/api/v1/backups/{backupId}/restore/full": {
			"post": {
				"tags": [
					"Backups"
				],
				"summary": "Restore full backup",
				"description": "Restores repository from a backup (replaces all data)",
				"operationId": "restoreFull",
				"parameters": [
					{
						"name": "backupId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK"
					}
				}
			}
		},
		"/api/v1/backups/restore/point-in-time": {
			"post": {
				"tags": [
					"Backups"
				],
				"summary": "Point-in-time restore",
				"description": "Restores repository to a specific point in time",
				"operationId": "restorePointInTime",
				"parameters": [
					{
						"name": "targetTime",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK"
					}
				}
			}
		},
		"/api/v1/backups/incremental": {
			"post": {
				"tags": [
					"Backups"
				],
				"summary": "Create incremental backup",
				"description": "Creates an incremental backup",
				"operationId": "createIncrementalBackup",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/BackupManifest"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/backups/full": {
			"post": {
				"tags": [
					"Backups"
				],
				"summary": "Create full backup",
				"description": "Creates a full backup of the repository",
				"operationId": "createFullBackup",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/BackupManifest"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/webhooks": {
			"get": {
				"tags": [
					"Notifications"
				],
				"summary": "List webhooks",
				"description": "List all webhook subscriptions",
				"operationId": "listWebhooks",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"*/*": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/WebhookSubscriptionInfo"
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/mqtt/info": {
			"get": {
				"tags": [
					"Notifications"
				],
				"summary": "Get MQTT info",
				"description": "Get MQTT broker connection information",
				"operationId": "getMqttInfo",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"*/*": {
								"schema": {
									"$ref": "#/components/schemas/MqttConnectionInfo"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/documents/{documentId}/versions": {
			"get": {
				"tags": [
					"Versions"
				],
				"summary": "List all versions of a document",
				"description": "Returns paginated list of all versions for a document, ordered by version number (newest first)",
				"operationId": "listVersions",
				"parameters": [
					{
						"name": "documentId",
						"in": "path",
						"description": "Document ID",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int64"
						},
						"example": 12345
					},
					{
						"name": "page",
						"in": "query",
						"description": "Page number (0-indexed)",
