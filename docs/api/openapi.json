{"openapi":"3.0.1","info":{"title":"Race Results Repository API","description":"# Race Results Repository API\n\nVersion-controlled repository for rowing regatta timing data based on the Timing Data Interchange EMF schema.\n\n## Features\n- **Version Control**: Full history tracking for all documents with EMF Compare-based diffs\n- **Document Types**: Support for Race Results, Start Lists, and other timing data\n- **Search**: Powerful search with exact, partial, and wildcard matching\n- **Authorization**: Role-based access control for regatta data\n- **Real-time**: Webhook and MQTT support for live updates\n\n## Data Format\nDocuments are stored as EMF (Eclipse Modeling Framework) models in XMI or binary format,\nconforming to the Timing Data Interchange schema for rowing regattas.\n\n## Authentication\nMost endpoints require JWT bearer token authentication. Include the token in the Authorization header:\n```\nAuthorization: Bearer <your-jwt-token>\n```\n","contact":{"name":"Race Results Repository Team","url":"https://github.com/rowtown/race-results-repository","email":"support@rowtown.org"},"license":{"name":"Apache 2.0","url":"https://www.apache.org/licenses/LICENSE-2.0"},"version":"1.0.0"},"externalDocs":{"description":"Timing Data Interchange Schema Documentation","url":"https://github.com/rowtown/timing-data-interchange"},"servers":[{"url":"http://localhost:8080","description":"Local development server"},{"url":"https://api.rowtown.org","description":"Production server"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Versions","description":"Version control API"},{"name":"Notifications","description":"Notification subscription API"},{"name":"Documents","description":"Document management API"},{"name":"Search","description":"Document search API"},{"name":"Backups","description":"Backup and restore API"}],"paths":{"/api/v1/documents/{id}":{"get":{"tags":["Documents"],"summary":"Get document by ID","description":"Retrieves the latest version of a document including all metadata and the EMF model data","operationId":"getDocument","parameters":[{"name":"id","in":"path","description":"Document ID","required":true,"schema":{"type":"integer","format":"int64"},"example":12345}],"responses":{"403":{"description":"Forbidden - insufficient permissions to access this document","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"404":{"description":"Document not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"200":{"description":"Document retrieved successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}}}},"put":{"tags":["Documents"],"summary":"Update document","description":"Updates a document by creating a new version. All previous versions are preserved for full history tracking.","operationId":"updateDocument","parameters":[{"name":"id","in":"path","description":"Document ID","required":true,"schema":{"type":"integer","format":"int64"},"example":12345},{"name":"changeDescription","in":"query","description":"Description of changes in this version","required":false,"schema":{"type":"string","default":"Updated document"},"example":"Updated race times after timing correction"},{"name":"format","in":"query","description":"Serialization format of the model data","required":false,"schema":{"type":"string","default":"XMI","enum":["XMI","JSON"]},"example":"XMI"}],"requestBody":{"description":"Binary EMF model data","content":{"application/octet-stream":{},"application/json":{"schema":{"type":"array","items":{"type":"string","format":"byte"}}}},"required":true},"responses":{"403":{"description":"Forbidden - insufficient permissions to update this document","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"400":{"description":"Invalid request - malformed model data or invalid format","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"404":{"description":"Document not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"200":{"description":"Document updated successfully, new version created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}}}},"delete":{"tags":["Documents"],"summary":"Delete document","description":"Permanently deletes a document and all its versions. This operation cannot be undone.","operationId":"deleteDocument","parameters":[{"name":"id","in":"path","description":"Document ID","required":true,"schema":{"type":"integer","format":"int64"},"example":12345}],"responses":{"403":{"description":"Forbidden - insufficient permissions to delete this document"},"404":{"description":"Document not found"},"204":{"description":"Document deleted successfully"}}}},"/api/v1/webhooks/subscribe":{"post":{"tags":["Notifications"],"summary":"Subscribe to webhook","description":"Register a webhook for document change notifications","operationId":"subscribeWebhook","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookSubscriptionRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/WebhookSubscriptionInfo"}}}}}}},"/api/v1/documents":{"post":{"tags":["Documents"],"summary":"Create a new race timing document","description":"Creates a new document with version 1. The document is stored with full version history and can include race results, start lists, or other timing data in EMF format.","operationId":"createDocument","requestBody":{"description":"Document creation request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentRequest"},"examples":{"Start List (Stotesbury Cup Regatta 2024)":{"description":"modelData is the base64-encoded XMI of a tdi:TimingRegatta model (truncated here; see src/test/resources/Stotesbury-2024-05-17-race-start-master-updated-startlist.tdi)","value":{"type":"START_LIST","regattaId":"Stotesbury Cup Regatta","regattaStartDate":"2024-05-17","versionType":"primary","author":"regatta.admin@stotesburycup.org","description":"Stotesbury Cup Regatta 2024 - master start list","tags":["official","start-list"],"metadata":{"raceCourse":"1500 Meter Head Course","date":"2024-05-17"},"modelData":"PHRkaTpUaW1pbmdSZWdhdHRhIHJlZ2F0dGFJZD0iU3RvdGVzYnVyeSBDdXAgUmVnYXR0YSIgLi4uLz4="}}}}},"required":true},"responses":{"409":{"description":"Conflict - document with same identifier already exists","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"201":{"description":"Document created successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"400":{"description":"Invalid request - missing required fields or invalid data format","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"403":{"description":"Forbidden - insufficient permissions for this regatta or document type","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}}}}},"/api/v1/documents/{documentId}/versions/rollback":{"post":{"tags":["Versions"],"summary":"Rollback document to previous version","description":"Creates a new version that restores the content from a previous version. The rollback itself becomes a new version in the history.","operationId":"rollback","parameters":[{"name":"documentId","in":"path","description":"Document ID","required":true,"schema":{"type":"integer","format":"int64"},"example":12345},{"name":"targetVersion","in":"query","description":"Version number to rollback to","required":true,"schema":{"type":"integer","format":"int64"},"example":3},{"name":"description","in":"query","description":"Description for the rollback operation","required":false,"schema":{"type":"string"},"example":"Reverting to pre-correction state"}],"responses":{"200":{"description":"Rollback successful, new version created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VersionInfo"}}}},"403":{"description":"Forbidden - insufficient permissions to rollback this document","content":{"*/*":{"schema":{"$ref":"#/components/schemas/VersionInfo"}}}},"404":{"description":"Document or target version not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/VersionInfo"}}}}}}},"/api/v1/documents/search":{"get":{"tags":["Search"],"summary":"Search documents","description":"Search for documents using query parameters. Supports exact, partial, and wildcard matching.","operationId":"search","parameters":[{"name":"documentId","in":"query","description":"Document ID to search for","required":false,"schema":{"type":"string"},"example":12345},{"name":"regattaId","in":"query","description":"Filter by regatta ID","required":false,"schema":{"type":"string"},"example":"Stotesbury Cup Regatta"},{"name":"regattaName","in":"query","description":"Search by regatta name","required":false,"schema":{"type":"string"},"example":"Stotesbury"},{"name":"type","in":"query","description":"Filter by document type","required":false,"schema":{"type":"string","enum":["START_LIST","RACE_RESULTS"]},"example":"RACE_RESULTS"},{"name":"raceId","in":"query","description":"Filter by race id (Race Results)","required":false,"schema":{"type":"string"},"example":"1a"},{"name":"milestoneId","in":"query","description":"Filter by milestone (Race Results)","required":false,"schema":{"type":"string"},"example":"Finish Line"},{"name":"timer","in":"query","description":"Filter by timer role (Race Results)","required":false,"schema":{"type":"string","enum":["PRIMARY","FIRST_BACKUP","SECOND_BACKUP"]},"example":"PRIMARY"},{"name":"author","in":"query","description":"Filter by author","required":false,"schema":{"type":"string"},"example":"john.doe@rowing.org"},{"name":"description","in":"query","description":"Search in document descriptions","required":false,"schema":{"type":"string"},"example":"heat 1"},{"name":"tags","in":"query","description":"Filter by tags (comma-separated)","required":false,"schema":{"type":"string"},"example":"finals,mens-8"},{"name":"metadataKey","in":"query","description":"Search for specific metadata key","required":false,"schema":{"type":"string"}},{"name":"metadataValue","in":"query","description":"Search for specific metadata value","required":false,"schema":{"type":"string"}},{"name":"page","in":"query","description":"Page number (0-indexed)","required":false,"schema":{"type":"integer","format":"int32","default":0},"example":0},{"name":"size","in":"query","description":"Page size","required":false,"schema":{"type":"integer","format":"int32","default":10},"example":10},{"name":"matchType","in":"query","description":"Match type: EXACT, PARTIAL, or WILDCARD","required":false,"schema":{"type":"string","description":"Match type for search queries","default":"EXACT","enum":["EXACT","PARTIAL","WILDCARD"]},"example":"PARTIAL"}],"responses":{"400":{"description":"Invalid search parameters","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SearchResults"}}}},"200":{"description":"Search completed successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResults"}}}}}},"post":{"tags":["Search"],"summary":"Advanced search","description":"Perform complex searches using a JSON query body. Useful for searches with multiple tags, metadata filters, or complex criteria.","operationId":"advancedSearch","requestBody":{"description":"Advanced search query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchQuery"},"examples":{"Find a regatta's start list":{"description":"Find a regatta's start list","value":{"regattaId":"Stotesbury Cup Regatta","documentType":"START_LIST","matchType":"PARTIAL","page":0,"size":20}}}}},"required":true},"responses":{"400":{"description":"Invalid search query","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SearchResults"}}}},"200":{"description":"Search completed successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResults"}}}}}}},"/api/v1/backups/{backupId}/restore/selective":{"post":{"tags":["Backups"],"summary":"Restore selective documents","description":"Restores specific documents from a backup","operationId":"restoreSelective","parameters":[{"name":"backupId","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"array","items":{"type":"integer","format":"int64"}}}},"required":true},"responses":{"200":{"description":"OK"}}}},"/api/v1/backups/{backupId}/restore/full":{"post":{"tags":["Backups"],"summary":"Restore full backup","description":"Restores repository from a backup (replaces all data)","operationId":"restoreFull","parameters":[{"name":"backupId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK"}}}},"/api/v1/backups/restore/point-in-time":{"post":{"tags":["Backups"],"summary":"Point-in-time restore","description":"Restores repository to a specific point in time","operationId":"restorePointInTime","parameters":[{"name":"targetTime","in":"query","required":true,"schema":{"type":"string","format":"date-time"}}],"responses":{"200":{"description":"OK"}}}},"/api/v1/backups/incremental":{"post":{"tags":["Backups"],"summary":"Create incremental backup","description":"Creates an incremental backup","operationId":"createIncrementalBackup","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BackupManifest"}}}}}}},"/api/v1/backups/full":{"post":{"tags":["Backups"],"summary":"Create full backup","description":"Creates a full backup of the repository","operationId":"createFullBackup","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BackupManifest"}}}}}}},"/api/v1/webhooks":{"get":{"tags":["Notifications"],"summary":"List webhooks","description":"List all webhook subscriptions","operationId":"listWebhooks","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/WebhookSubscriptionInfo"}}}}}}}},"/api/v1/mqtt/info":{"get":{"tags":["Notifications"],"summary":"Get MQTT info","description":"Get MQTT broker connection information","operationId":"getMqttInfo","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MqttConnectionInfo"}}}}}}},"/api/v1/documents/{documentId}/versions":{"get":{"tags":["Versions"],"summary":"List all versions of a document","description":"Returns paginated list of all versions for a document, ordered by version number (newest first)","operationId":"listVersions","parameters":[{"name":"documentId","in":"path","description":"Document ID","required":true,"schema":{"type":"integer","format":"int64"},"example":12345},{"name":"page","in":"query","description":"Page number (0-indexed)","required":false,"schema":{"type":"integer","format":"int32","default":0},"example":0},{"name":"size","in":"query","description":"Page size","required":false,"schema":{"type":"integer","format":"int32","default":10},"example":10}],"responses":{"200":{"description":"Versions retrieved successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"404":{"description":"Document not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageVersionInfo"}}}}}}},"/api/v1/documents/{documentId}/versions/{version}":{"get":{"tags":["Versions"],"summary":"Get specific version","description":"Retrieves detailed information about a specific version of a document (metadata only, no model data)","operationId":"getVersion","parameters":[{"name":"documentId","in":"path","description":"Document ID","required":true,"schema":{"type":"integer","format":"int64"},"example":12345},{"name":"version","in":"path","description":"Version number","required":true,"schema":{"type":"integer","format":"int64"},"example":3}],"responses":{"200":{"description":"Version retrieved successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VersionInfo"}}}},"404":{"description":"Document or version not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/VersionInfo"}}}}}}},"/api/v1/documents/{documentId}/versions/{v1}/compare/{v2}":{"get":{"tags":["Versions"],"summary":"Compare two versions","description":"Compares two versions of a document and returns a detailed diff showing all changes between them using EMF Compare","operationId":"compareVersions","parameters":[{"name":"documentId","in":"path","description":"Document ID","required":true,"schema":{"type":"integer","format":"int64"},"example":12345},{"name":"v1","in":"path","description":"First version number","required":true,"schema":{"type":"integer","format":"int64"},"example":3},{"name":"v2","in":"path","description":"Second version number","required":true,"schema":{"type":"integer","format":"int64"},"example":5}],"responses":{"200":{"description":"Comparison completed successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ModelDiff"}}}},"400":{"description":"Versions cannot be compared (format mismatch or corrupt data)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ModelDiff"}}}},"404":{"description":"Document or one of the versions not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ModelDiff"}}}}}}},"/api/v1/backups":{"get":{"tags":["Backups"],"summary":"List backups","description":"Lists all available backups","operationId":"listBackups","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/BackupManifest"}}}}}}}},"/api/v1/webhooks/{id}":{"delete":{"tags":["Notifications"],"summary":"Unsubscribe webhook","description":"Remove a webhook subscription","operationId":"unsubscribeWebhook","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK"}}}},"/api/v1/backups/{backupId}":{"delete":{"tags":["Backups"],"summary":"Delete backup","description":"Deletes a specific backup","operationId":"deleteBackup","parameters":[{"name":"backupId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK"}}}}},"components":{"schemas":{"DocumentResponse":{"type":"object","properties":{"documentId":{"type":"integer","description":"Unique document identifier","format":"int64","example":12345},"type":{"type":"string","description":"Type of document","example":"RACE_RESULTS","enum":["START_LIST","RACE_RESULTS"]},"regattaId":{"type":"string","description":"Regatta name (identifies the regatta together with regattaStartDate)","example":"Stotesbury Cup Regatta"},"regattaStartDate":{"type":"string","description":"Start date of the regatta (part of the regatta key)","format":"date","example":"2024-05-17"},"raceId":{"type":"string","description":"Race identifier (Race Results only), derived from the model","example":"1a"},"milestoneId":{"type":"string","description":"Timing milestone (Race Results only)","example":"Finish Line"},"timer":{"type":"string","description":"Which redundant timer produced these results (Race Results only)","example":"PRIMARY","enum":["PRIMARY","FIRST_BACKUP","SECOND_BACKUP"]},"author":{"type":"string","description":"Document author","example":"john.doe@rowing.org"},"createdAt":{"type":"string","description":"Timestamp when document was created","format":"date-time"},"latestVersion":{"type":"integer","description":"Latest version number","format":"int64","example":5},"description":{"type":"string","description":"Document description","example":"Final race results for Heat 1"},"tags":{"uniqueItems":true,"type":"array","description":"Document tags","example":["finals","mens-8"],"items":{"type":"string","description":"Document tags","example":"[\"finals\",\"mens-8\"]"}},"metadata":{"type":"object","additionalProperties":{"type":"string","description":"Custom metadata"},"description":"Custom metadata"},"modelData":{"typ