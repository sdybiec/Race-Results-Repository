","description":"Human-readable description of the document","example":"Final race results for Heat 1"},"tags":{"uniqueItems":true,"type":"array","description":"Set of tags for categorization","example":["finals","mens-8"],"items":{"type":"string","description":"Set of tags for categorization","example":"[\"finals\",\"mens-8\"]"}},"metadata":{"type":"object","additionalProperties":{"type":"string","description":"Custom metadata as key-value pairs"},"description":"Custom metadata as key-value pairs"},"modelData":{"type":"string","description":"Binary EMF model data (XMI or binary format)","format":"binary"}},"description":"Request payload for creating a new race timing document"},"VersionInfo":{"type":"object","properties":{"versionId":{"type":"integer","description":"Unique version identifier","format":"int64","example":67890},"documentId":{"type":"integer","description":"Document this version belongs to","format":"int64","example":12345},"versionNumber":{"type":"integer","description":"Version number (sequential)","format":"int64","example":5},"timestamp":{"type":"string","description":"When this version was created","format":"date-time"},"author":{"type":"string","description":"Who created this version","example":"john.doe@rowing.org"},"changeDescription":{"type":"string","description":"Description of changes in this version","example":"Updated race times after timing correction"},"checksum":{"type":"string","description":"SHA-256 checksum of model data","example":"a3b5c7d9e1f2a4b6c8d0e2f4a6b8c0d2e4f6a8b0c2d4e6f8a0b2c4d6e8f0a2b4"},"size":{"type":"integer","description":"Size of model data in bytes","format":"int64","example":2048}},"description":"Version metadata without the full document data"},"SearchQuery":{"type":"object","properties":{"documentId":{"type":"string","description":"Document ID to search for","example":"12345"},"regattaId":{"type":"string","description":"Regatta name to filter by","example":"Stotesbury Cup Regatta"},"regattaStartDate":{"type":"string","description":"Regatta start date to filter by (exact match; distinguishes annual editions)","format":"date","example":"2024-05-17"},"regattaName":{"type":"string","description":"Regatta name to search for","example":"Stotesbury Cup Regatta"},"documentType":{"type":"string","description":"Type of document to filter by","example":"RACE_RESULTS","enum":["START_LIST","RACE_RESULTS"]},"raceId":{"type":"string","description":"Race identifier to filter by (Race Results)","example":"1a"},"milestoneId":{"type":"string","description":"Timing milestone to filter by (Race Results)","example":"Finish Line"},"timer":{"type":"string","description":"Timer role to filter by (Race Results)","example":"PRIMARY","enum":["PRIMARY","FIRST_BACKUP","SECOND_BACKUP"]},"author":{"type":"string","description":"Author to filter by","example":"john.doe@rowing.org"},"description":{"type":"string","description":"Search in document descriptions","example":"heat 1"},"tags":{"uniqueItems":true,"type":"array","description":"Tags to filter by","example":["finals","mens-8"],"items":{"type":"string","description":"Tags to filter by","example":"[\"finals\",\"mens-8\"]"}},"metadataKey":{"type":"string","description":"Metadata key to search for"},"metadataValue":{"type":"string","description":"Metadata value to search for"},"page":{"type":"integer","description":"Page number (0-indexed)","format":"int32","example":0,"default":0},"size":{"type":"integer","description":"Number of results per page","format":"int32","example":10,"default":10},"matchType":{"type":"string","description":"Match type for search queries","example":"PARTIAL","default":"EXACT","enum":["EXACT","PARTIAL","WILDCARD"]}},"description":"Search query parameters for finding documents"},"DocumentSummary":{"type":"object","properties":{"documentId":{"type":"integer","format":"int64"},"type":{"type":"string","enum":["START_LIST","RACE_RESULTS"]},"regattaId":{"type":"string"},"regattaStartDate":{"type":"string","format":"date"},"raceId":{"type":"string"},"milestoneId":{"type":"string"},"timer":{"type":"string","enum":["PRIMARY","FIRST_BACKUP","SECOND_BACKUP"]},"latestVersion":{"type":"integer","format":"int64"},"lastModified":{"type":"string","format":"date-time"},"author":{"type":"string"},"description":{"type":"string"},"tags":{"uniqueItems":true,"type":"array","items":{"type":"string"}},"metadata":{"type":"object","additionalProperties":{"type":"string"}}},"description":"List of matching documents"},"SearchResults":{"type":"object","properties":{"total":{"type":"integer","description":"Total number of matching documents","format":"int64","example":42},"page":{"type":"integer","description":"Current page number (0-indexed)","format":"int32","example":0},"pageSize":{"type":"integer","description":"Number of results per page","format":"int32","example":10},"results":{"type":"array","description":"List of matching documents","items":{"$ref":"#/components/schemas/DocumentSummary"}}},"description":"Paginated search results"},"BackupManifest":{"type":"object","properties":{"backupId":{"type":"string"},"backupType":{"type":"string","enum":["FULL","INCREMENTAL"]},"timestamp":{"type":"string","format":"date-time"},"documentCount":{"type":"integer","format":"int64"},"versionCount":{"type":"integer","format":"int64"},"totalSize":{"type":"integer","format":"int64"},"lastBackupId":{"type":"string"},"startTime":{"type":"string","format":"date-time"},"endTime":{"type":"string","format":"date-time"},"status":{"type":"string","enum":["IN_PROGRESS","COMPLETED","FAILED"]}}},"MqttConnectionInfo":{"type":"object","properties":{"brokerUrl":{"type":"string"},"topicPrefix":{"type":"string"},"startListTopicPattern":{"type":"string"},"raceResultsTopicPattern":{"type":"string"}}},"Page":{"type":"object","properties":{"totalElements":{"type":"integer","format":"int64"},"totalPages":{"type":"integer","format":"int32"},"size":{"type":"integer","format":"int32"},"content":{"type":"array","items":{"type":"object"}},"number":{"typ